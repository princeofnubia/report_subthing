# Copy this file to .env and fill in real values. Never commit the real .env file.

# Database (same one used by send-daily-report.js)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database

# Admin login
ADMIN_USERNAME=admin
# Generate with: node generate-password-hash.js "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Session cookie signing secret — use a long random string
SESSION_SECRET=change-this-to-a-long-random-string

# Optional
PORT=3000

# Zoho SMTP (used by cron/send-daily-report.js)
# Generate an app-specific password at: Zoho Mail > Settings > Security > App Passwords
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_FROM_NAME=Reports

# CSV report generation (used by lib/report-job.js via the mysql CLI, same
# pipeline as the existing shell process)
# Transactions database servers, comma-separated. Each host is read in the
# order listed (first host's rows first) and the results are combined into
# one report. Private/local IPs are fine; append :port if not 3306.
# All hosts share the same user, password and database name below.
REPORT_DB_HOSTS=10.0.0.5,10.0.0.6,192.168.1.20:3307
REPORT_DB_USER=your_report_db_user
REPORT_DB_PASSWORD=your_report_db_password
REPORT_DB_NAME=database
# Only used when REPORT_DB_HOSTS is empty: path to the .my.cnf-style
# credentials file for a single transactions database
REPORT_MYSQL_DEFAULTS_FILE=/root/.my.cnf.do
# database.table the report query reads from (defaults to
# <REPORT_DB_NAME>.transactions)
REPORT_DB_TABLE=database.transactions
# Directory the CSV is written to before sending, then deleted from after
REPORT_OUTPUT_DIR=/var/reports
